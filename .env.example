# Default URL of the remote comfystream instance the frontend connects to.
# Can also be changed at runtime via the Settings dialog in the UI.
# Copy this file to .env.local and adjust as needed.
NEXT_PUBLIC_DEFAULT_STREAM_URL=http://localhost:8889

# Initial output-stream box layout (position + scale). Dial it in with the
# arrow keys (10px nudges) and w/e (2% scale) hotkeys, then copy the values
# shown in the bottom-left readout (non-focus mode) back into these vars.
NEXT_PUBLIC_OUTPUT_OFFSET_X=0
NEXT_PUBLIC_OUTPUT_OFFSET_Y=0
NEXT_PUBLIC_OUTPUT_SCALE=1

# Launch showing only the output stream (focus mode). In focus mode the Stream
# Settings panel is hidden and the stream auto-connects once the workflow and
# camera have loaded — no user input needed. Set to false to start with the full
# UI visible and connect manually. Toggle the view at runtime with the `q` hotkey.
NEXT_PUBLIC_FOCUS_MODE=true

# Default Comfy workflow JSON to pre-load in the UI (path relative to the project
# root). Read server-side via /api/config and prefilled into Stream Settings;
# upload a file in the UI to override it.
# NEXT_PUBLIC_DEFAULT_WORKFLOW=workflows/final_260603.json
